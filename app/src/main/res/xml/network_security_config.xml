<?xml version="1.0" encoding="utf-8"?>
<!-- The SAM Online / DHAKA-FLIX servers are plain-HTTP BDIX hosts on private IPs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
